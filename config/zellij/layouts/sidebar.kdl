// Zellij 隐藏式导航 dock 布局（WezTerm4Neil 第二层，v4 = 真正实现隐藏导航，2026-09-08）
//
// ┌────────────────────────────────────────────────┐
// │ tab-bar                                        │
// ├──────────────┬─────────────────────────────────┤
// │ dock-servers │  💻 终端（默认聚焦；默认不显示    │
// │ (20%×49%)    │  dock → 主终端整屏全宽）         │
// ├──────────────┤                                 │
// │ dock-files   │                                 │
// │ (20%×49%)    │                                 │
// ├──────────────┴─────────────────────────────────┤
// │ status-bar                                     │
// └────────────────────────────────────────────────┘
//
// 默认【不显示】左侧导航；按 Alt+d 呼出（dock 覆盖在左侧约 20%，不重排右侧），
// 再按一次隐藏 → 主终端恢复全宽。dock 由两个 floating pane 组成：
//   上 = 服务器列表：nav4neil --section servers（点选服务器 → 开新 Zellij tab）
//   下 = 文件浏览  ：nav4neil --section files  （Enter → wz-open 悬浮编辑器）
//
// 为什么用 floating pane 而不是固定 20% 平铺（v3）：
//   * 显隐不改变右侧 pane 尺寸 → 主终端始终全宽，无布局跳变、不杀进程；
//   * Zellij 0.45.1 布局支持 floating_panes 节点 + x/y/width/height，
//     tab 上 hide_floating_panes=true 可在启动时隐藏（实测生效）。
//
// ⚠️ 关键坑（实测 0.45.1）：hide_floating_panes 在「带 default_tab_template 的布局」
//   中不生效（zellij-org/zellij#2974 同类问题），因此本布局改为在 tab 内显式放
//   tab-bar/status-bar 插件 pane，不用 default_tab_template ——
//   代价：之后手动新开的 tab（Ctrl+t → n）不再自动带上下栏（功能不受影响）。
//
// 按键（normal 模式）：
//   Alt+d（config.kdl 新增）或 Alt+f（Zellij 默认）＝ ToggleFloatingPanes：呼出/隐藏 dock
//   呼出后焦点直接落在 dock（实测 0.45.1：焦点=浮窗组内「最后声明的 pane」→ 让 dock-files
//   先声明、dock-servers 后声明，呼出即聚焦上方的服务器区）；dock 内部用 Alt+j/↓ 到文件区、
//   Alt+k/↑ 到服务器区。
//   说明：Zellij 0.45 浮窗是独立焦点层，MoveFocus 只能在 dock 两格之间走；
//         “Alt+方向 从主区移入 nav” 即由呼出动作完成（呼出=焦点进入 dock）；
//         想回主终端：再按 Alt+d 隐藏（浮窗隐藏后焦点自动回主终端）。
//
// 跑法：pane 内先探测 PATH 是否有 nav4neil；缺则退化为 fish/bash 提示，不影响右侧。
//
// 历史：
//   v1 = 上 40% server-menu.sh + 下 60% yazi（2026-09 之前）
//   v2 = 单 pane nav4neil 上下两区（2026-09-06 一期）
//   v3 = 左侧 20% 平铺两段 nav4neil（--section servers / files）
//   v4 = 隐藏式导航 dock：floating pane 覆盖左侧 ~20%，默认隐藏（本期 M10）
layout {
    tab name="Workspace" hide_floating_panes=true {
        // 显式把上下栏放进 tab（不能用 default_tab_template，见上「关键坑」）
        pane split_direction="vertical" {
            pane size=1 borderless=true {
                plugin location="zellij:tab-bar"
            }
            pane name="💻 终端" focus=true
            pane size=1 borderless=true {
                plugin location="zellij:status-bar"
            }
        }
        floating_panes {
            // 顺序有讲究：dock-files 先声明、dock-servers 后声明 →
            // 呼出 dock 时焦点落在 dock-servers（最后声明的浮窗），符合“从上往下用”。
            pane name="dock-files" x="0%" y="50%" width="20%" height="49%" {
                command "bash"
                args "-lc" "if command -v nav4neil >/dev/null 2>&1; then exec nav4neil --section files; else echo '⚠ nav4neil 未安装 — 装到 ~/.local/bin 后重进即热插入'; exec fish 2>/dev/null || exec bash; fi"
            }
            pane name="dock-servers" x="0%" y="1%" width="20%" height="49%" {
                command "bash"
                args "-lc" "if command -v nav4neil >/dev/null 2>&1; then exec nav4neil --section servers; else echo '⚠ nav4neil 未安装 — 装到 ~/.local/bin 后重进即热插入'; exec fish 2>/dev/null || exec bash; fi"
            }
        }
    }
}
